{
  // Stricter profile for user-facing docs without noisy formatting churn.
  "ignores": [
    ".claude/**",
    ".cursor/hooks/**",
    "node_modules/**",
    "dist/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "config": {
    "default": false,
    "MD001": true,
    "MD003": true,
    "MD024": true,
    "MD025": true,
    "MD033": true,
    "MD034": true,
    "MD040": true,
    "MD041": true,
    "MD046": true
  }
}
