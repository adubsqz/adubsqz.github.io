{
  "name": "adubsqz-photography",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "lint:md": "npx markdownlint-cli2 \"**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}\" \"!**/*.code-search\" \"!**/bower_components\" \"!**/node_modules\" \"!**/.git\" \"!**/vendor\"",
    "lint:md:docs": "npx markdownlint-cli2 --config .markdownlint-docs.jsonc \"README.md\" \"SETUP.md\" \"AGENTS.md\" \"docs/**/*.md\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node playwright-cli.mjs test",
    "test:e2e:load": "node playwright-cli.mjs test e2e/load.spec.ts e2e/gallery-layout.spec.ts",
    "test:e2e:ui": "node playwright-cli.mjs test --ui",
    "test:e2e:headed": "node playwright-cli.mjs test --headed",
    "playwright:install": "node playwright-cli.mjs install chromium",
    "gallery:test": "bash tools/run_gallery_pytest.sh",
    "gallery:import": "bash tools/run_gallery_module.sh gallery.run_import",
    "gallery:verify": "bash tools/run_gallery_module.sh gallery.verify_manifest",
    "gallery:doctor": "bash tools/run_gallery_module.sh gallery.doctor",
    "gallery:draft-probe-map": "bash tools/run_gallery_module.sh gallery.draft_probe_map",
    "gallery:draft-bw-prefix-map": "bash tools/run_gallery_module.sh gallery.draft_bw_prefix_map",
    "gallery:draft-compound-manifest-map": "bash tools/run_gallery_module.sh gallery.draft_compound_manifest_map",
    "gallery:promote": "bash tools/run_gallery_module.sh gallery.run_promote"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "playwright-cli": "^0.262.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.1.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
